# Supabase（マイページ登録・データ引き継ぎ — 必須）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI（AIチャット用。未設定時はルールベースのフォールバック）
OPENAI_API_KEY=

# ご意見フォーム（任意の外部フォーム URL）
NEXT_PUBLIC_TRUST_FEEDBACK_FORM_URL=

# 改善のご意見の送信先（サーバーのみ。画面・公開JSには出さない）
TRUST_FEEDBACK_EMAIL=

# LINE Messaging API（プッシュ通知用・本人確認には不要）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 任意: Resend を使う場合
RESEND_API_KEY=
RESEND_FROM_EMAIL=
