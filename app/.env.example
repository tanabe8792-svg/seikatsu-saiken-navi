# Supabase（マイページ登録・データ引き継ぎ — 必須）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# アカウント削除API用（サーバーのみ。画面には出さない）
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI（AIチャット用。未設定時はルールベースのフォールバック）
OPENAI_API_KEY=

# 改善のご意見の送信先（サーバーのみ。画面・公開JSには出さない）
TRUST_FEEDBACK_EMAIL=

# Resend（改善の声・応援メッセージを確実に届けるため推奨）
RESEND_API_KEY=
# 例: 生活再建ナビ <noreply@your-verified-domain.com>
# 未設定時は Resend 試験用アドレス（届かない場合あり）
RESEND_FROM_EMAIL=

# 任意: 外部フォーム URL（補助。本体フォームは常に表示）
NEXT_PUBLIC_TRUST_FEEDBACK_FORM_URL=

# 任意: 活動費支援（おすすめ: Stripe Payment Links）
# 自由金額（顧客が金額を選択するリンク）→ アプリの「金額を自分で決める」
NEXT_PUBLIC_SUPPORT_DONATION_URL=
NEXT_PUBLIC_SUPPORT_DONATION_URL_CUSTOM=
# 固定金額リンク
NEXT_PUBLIC_SUPPORT_DONATION_URL_500=
NEXT_PUBLIC_SUPPORT_DONATION_URL_1000=
NEXT_PUBLIC_SUPPORT_DONATION_URL_3000=
# 任意: PayPay.me など PayPay 専用
NEXT_PUBLIC_SUPPORT_PAYPAY_URL=
