OPENAI_API_KEY=

# Supabase（マイページ永続化用。未設定時はブラウザ内保存）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ご意見フォーム（任意の外部フォーム URL）
NEXT_PUBLIC_TRUST_FEEDBACK_FORM_URL=

# 改善のご意見の送信先（サーバーのみ。画面・公開JSには出さない）
TRUST_FEEDBACK_EMAIL=

# 任意: Resend を使う場合
RESEND_API_KEY=
RESEND_FROM_EMAIL=
